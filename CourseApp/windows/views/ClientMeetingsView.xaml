<UserControl x:Class="CourseApp.windows.views.ClientMeetingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="2,2,4,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder" Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="2" CornerRadius="16" ClipToBounds="True" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Color="#30FF2A55"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#FFD3E2"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FFF0F5" CornerRadius="10" Padding="5" BorderBrush="#FF85A1" BorderThickness="1.5" HorizontalAlignment="Left" Margin="0,0,0,15">
                                <TabPanel IsItemsHost="True"/>
                            </Border>

                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="8" Padding="15,8" Margin="2,0" TextElement.Foreground="#2D3436">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFD6E0"/>
                                <Setter TargetName="TabBorder" Property="TextElement.Foreground" Value="#FF2A55"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FF2A55"/>
                                <Setter TargetName="TabBorder" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MeetingCardTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" Background="#FFD6E0" BorderBrush="#FF85A1" BorderThickness="1.5" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="📅" FontSize="19" Foreground="#FF2A55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="{Binding PartnerName}" FontSize="15" FontWeight="Bold" Foreground="#1E272E" VerticalAlignment="Center"/>
                        <Border Background="{Binding StatusBackground}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusForeground}"/>
                        </Border>
                        <Border Background="#FFD6E0" CornerRadius="6" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DirectionText}" FontSize="11" FontWeight="Bold" Foreground="#8E44AD"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DateText}" FontSize="12.5" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding LocationText}" FontSize="12.5" FontWeight="Bold" Foreground="#2D3436"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button Content="✅ Прийняти" Background="#00B894" Foreground="White" Margin="0,0,8,0" Visibility="{Binding AcceptVisibility}" Style="{StaticResource SmallActionButtonStyle}"
                            Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>

                    <Button Content="❌ Відхилити" Background="#D63031" Foreground="White" Visibility="{Binding DeclineVisibility}" Style="{StaticResource SmallActionButtonStyle}"
                            Command="{Binding DataContext.DeclineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>

                    <Button Content="🚫 Скасувати" Background="#D63031" Foreground="White" Visibility="{Binding CancelVisibility}" Style="{StaticResource SmallActionButtonStyle}"
                            Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFC3A0" Offset="0.0"/>
                <GradientStop Color="#FFAFBD" Offset="0.4"/>
                <GradientStop Color="#D4A5FF" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="📅 Мої зустрічі" FontSize="22" FontWeight="Bold" Foreground="#1E272E"/>
                <TextBlock Text="Вхідні та вихідні запрошення, заплановані побачення та історія" FontSize="12.5" FontWeight="Bold" Foreground="#2D3436" Margin="0,3,0,0"/>
            </StackPanel>

            <TabControl Grid.Row="1" Style="{StaticResource ModernTabControlStyle}">
                <TabItem Header="⏳ Очікують" Style="{StaticResource ModernTabItemStyle}">
                    <Grid>
                        <ListBox x:Name="PendingListBox" ItemsSource="{Binding PendingMeetings}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource CardItemStyle}" ItemTemplate="{StaticResource MeetingCardTemplate}"/>

                        <Border x:Name="EmptyPendingPanel" Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="2" CornerRadius="16" Padding="30" Visibility="{Binding EmptyPendingVisibility}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="⏳" FontSize="36" Foreground="#FF2A55" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Немає активних запрошень" FontSize="15.5" FontWeight="Bold" Foreground="#1E272E" HorizontalAlignment="Center"/>
                                <TextBlock Text="Запросіть когось у розділі «Пошук пари» або дочекайтеся запрошення." FontSize="12.5" FontWeight="Bold" Foreground="#2D3436" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="✅ Заплановані" Style="{StaticResource ModernTabItemStyle}">
                    <Grid>
                        <ListBox x:Name="ScheduledListBox" ItemsSource="{Binding ScheduledMeetings}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource CardItemStyle}" ItemTemplate="{StaticResource MeetingCardTemplate}"/>

                        <Border x:Name="EmptyScheduledPanel" Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="2" CornerRadius="16" Padding="30" Visibility="{Binding EmptyScheduledVisibility}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📅" FontSize="36" Foreground="#FF2A55" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Немає запланованих зустрічей" FontSize="15.5" FontWeight="Bold" Foreground="#1E272E" HorizontalAlignment="Center"/>
                                <TextBlock Text="Підтверджені побачення відображатимуться тут." FontSize="12.5" FontWeight="Bold" Foreground="#2D3436" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="📜 Історія" Style="{StaticResource ModernTabItemStyle}">
                    <Grid>
                        <ListBox x:Name="HistoryListBox" ItemsSource="{Binding HistoryMeetings}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource CardItemStyle}" ItemTemplate="{StaticResource MeetingCardTemplate}"/>

                        <Border x:Name="EmptyHistoryPanel" Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="2" CornerRadius="16" Padding="30" Visibility="{Binding EmptyHistoryVisibility}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📜" FontSize="36" Foreground="#FF2A55" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Історія порожня" FontSize="15.5" FontWeight="Bold" Foreground="#1E272E" HorizontalAlignment="Center"/>
                                <TextBlock Text="Минулі, скасовані або відхилені зустрічі з'являться тут." FontSize="12.5" FontWeight="Bold" Foreground="#2D3436" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>