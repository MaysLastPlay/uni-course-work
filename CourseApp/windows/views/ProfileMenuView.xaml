<UserControl x:Class="CourseApp.windows.views.ProfileMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#D63031"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="Background" Value="#FFF0F5"/>
            <Setter Property="BorderBrush" Value="#FF85A1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FFE4E1"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FFE4E1"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MultiLineBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputBoxStyle}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="74"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10,8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FFE4E1"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FFE4E1"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LocalComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFD6E0"/>
                                <Setter Property="Foreground" Value="#FF2A55"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFB3C6"/>
                                <Setter Property="Foreground" Value="#FF2A55"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource LocalComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="MainBorder" Background="#FFF0F5" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="#D63031" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MainBorder" Property="Background" Value="#FFE4E1"/>
                                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF2A55"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="MainBorder" Property="Background" Value="#FFE4E1"/>
                                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF2A55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}" Margin="12,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0" Padding="0,3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFC3A0" Offset="0.0"/>
                <GradientStop Color="#FFAFBD" Offset="0.4"/>
                <GradientStop Color="#D4A5FF" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="✏️ Редагування профілю" FontSize="22" FontWeight="Bold" Foreground="#1E272E"/>
                <TextBlock Text="Фотографії, особисті дані, хобі, параметри, зміна пароля або деактивація акаунту" FontSize="12.5" FontWeight="Bold" Foreground="#2D3436" Margin="0,3,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <StackPanel Margin="2,2,8,4">
                    <Border BorderBrush="#C77DFF" BorderThickness="2" CornerRadius="18" ClipToBounds="True" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#408A2BE2"/>
                        </Border.Effect>
                        <Grid>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFE4E1" Offset="0.0"/>
                                        <GradientStop Color="#F3E8FF" Offset="0.5"/>
                                        <GradientStop Color="#E2C6FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Canvas IsHitTestVisible="False">
                                <Ellipse Width="200" Height="200" Fill="#6C5CE7" Canvas.Right="-50" Canvas.Bottom="-50" Opacity="0.3">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="65"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>

                            <StackPanel Margin="18">
                                <TextBlock Text="Аватарка та фотографії профілю" Style="{StaticResource SectionTitleStyle}"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="96" Height="96" CornerRadius="48" Background="#FFF0F5" BorderBrush="#FF2A55" BorderThickness="2" ClipToBounds="True" Margin="0,0,16,0">
                                        <Grid>
                                            <TextBlock x:Name="AvatarPlaceholderText" Text="♥" FontSize="36" FontWeight="Bold" Foreground="#FF2A55" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PlaceholderVisibility}"/>
                                            <Image x:Name="AvatarPreviewImage" Source="{Binding Avatar}" Visibility="{Binding AvatarVisibility}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Головна аватарка" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBlock x:Name="AvatarFileNameText" Text="{Binding AvatarName}" FontSize="12" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🖼️ Обрати аватарку" Height="36" Background="#FF2A55" Foreground="White" Margin="0,0,10,0" Style="{StaticResource ActionButtonStyle}" Command="{Binding PickAvatarCommand}"/>
                                            <Button Content="🗑️ Прибрати" Height="36" Background="#FFB3C6" Foreground="#1E272E" Style="{StaticResource ActionButtonStyle}" Command="{Binding ClearAvatarCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Мої фотографії у профілі" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0"/>
                                    <Button Content="➕ Додати фото" Height="34" HorizontalAlignment="Right" Background="#8E44AD" Foreground="White" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddPhotosCommand}"/>
                                </DockPanel>

                                <ItemsControl x:Name="GalleryItemsControl" ItemsSource="{Binding Photos}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="116" Height="116" CornerRadius="12" Background="#FFF0F5" BorderBrush="#FF85A1" BorderThickness="1.5" ClipToBounds="True" Margin="0,0,10,10">
                                                <Grid>
                                                    <Image Source="{Binding}" Stretch="UniformToFill"/>
                                                    <Button Content="✕" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Background="#D63031" Foreground="White" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="EmptyGalleryText" Text="Додаткових фотографій поки немає." FontSize="12" FontWeight="Bold" Foreground="#2D3436" Visibility="{Binding EmptyGalleryVisibility}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#FF85A1" BorderThickness="2" CornerRadius="18" ClipToBounds="True" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#40FF2A55"/>
                        </Border.Effect>
                        <Grid>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFCE4" Offset="0.0"/>
                                        <GradientStop Color="#FFE4E1" Offset="0.5"/>
                                        <GradientStop Color="#FFD3E2" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Canvas IsHitTestVisible="False">
                                <Ellipse Width="200" Height="200" Fill="#FF2A55" Canvas.Left="-50" Canvas.Top="-50" Opacity="0.3">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="65"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>

                            <StackPanel Margin="18">
                                <TextBlock Text="Особисті дані та параметри" Style="{StaticResource SectionTitleStyle}"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="105"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ПІБ Клієнта*" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="FullNameBox" Style="{StaticResource InputBoxStyle}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Стать*" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="GenderComboBox" Height="36" SelectedIndex="{Binding GenderIndex}">
                                            <ComboBoxItem Content="Чоловіча"/>
                                            <ComboBoxItem Content="Жіноча"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Вік (від 18)*" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="AgeBox" Style="{StaticResource InputBoxStyle}" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Зріст (см)" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="HeightBox" Style="{StaticResource InputBoxStyle}" ToolTip="Наприклад: 175" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Вага (кг)" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="WeightBox" Style="{StaticResource InputBoxStyle}" ToolTip="Наприклад: 68" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Хобі та захоплення" Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,6"/>

                                <Grid Margin="0,0,0,10">
                                    <ToggleButton x:Name="HobbiesPopupToggle"
                                                  Height="38"
                                                  HorizontalContentAlignment="Stretch"
                                                  Cursor="Hand"
                                                  IsChecked="{Binding IsOpen, ElementName=HobbiesPopup, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="ToggleBorder"
                                                        Background="#FFF0F5"
                                                        BorderBrush="#FF85A1"
                                                        BorderThickness="1.5"
                                                        CornerRadius="10"
                                                        Padding="12,0">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ToggleBorder" Property="Background" Value="#FFE4E1"/>
                                                        <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#FF2A55"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ToggleBorder" Property="Background" Value="#FFE4E1"/>
                                                        <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#FF2A55"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="22"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock x:Name="HobbiesSummaryText"
                                                       Grid.Column="0"
                                                       Text="{Binding HobbiesSummary}"
                                                       FontSize="12.5"
                                                       FontWeight="Bold"
                                                       Foreground="#1E272E"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <Border Grid.Column="1"
                                                    Background="#FFD6E0"
                                                    CornerRadius="8"
                                                    Padding="7,2"
                                                    Margin="8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="HobbiesCountBadge"
                                                           Text="{Binding HobbiesCount}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#FF2A55"/>
                                            </Border>

                                            <Path Grid.Column="2"
                                                  Data="M 0 0 L 4.5 4.5 L 9 0"
                                                  Stroke="#D63031"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                    </ToggleButton>

                                    <Popup x:Name="HobbiesPopup"
                                           PlacementTarget="{Binding ElementName=HobbiesPopupToggle}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Slide">
                                        <Border Width="{Binding ActualWidth, ElementName=HobbiesPopupToggle}"
                                                Background="#FFFCE4"
                                                BorderBrush="#FF2A55"
                                                BorderThickness="2"
                                                CornerRadius="14"
                                                Padding="14"
                                                Margin="0,6,0,10">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#45FF2A55"/>
                                            </Border.Effect>

                                            <StackPanel>
                                                <TextBlock Text="Хоббі на вибір"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#8E44AD"
                                                           Margin="0,0,0,8"/>

                                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                                    <ItemsControl x:Name="PresetHobbiesItemsControl" ItemsSource="{Binding PresetHobbies}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Title}"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          Margin="0,0,14,8"
                                                                          FontSize="12"
                                                                          FontWeight="Bold"
                                                                          Foreground="#1E272E"
                                                                          Cursor="Hand"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <ItemsControl x:Name="SelectedHobbiesItemsControl" ItemsSource="{Binding SelectedHobbies}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#FFD6E0"
                                                                    BorderBrush="#FF2A55"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Padding="9,4"
                                                                    Margin="0,0,6,6">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding}"
                                                                               FontSize="12"
                                                                               FontWeight="Bold"
                                                                               Foreground="#1E272E"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,6,0"/>
                                                                    <Button Content="✕"
                                                                            Width="18"
                                                                            Height="18"
                                                                            Background="#FF2A55"
                                                                            Foreground="White"
                                                                            FontSize="10"
                                                                            FontWeight="Bold"
                                                                            BorderThickness="0"
                                                                            Cursor="Hand"
                                                                            Command="{Binding DataContext.RemoveHobbyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="9">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <TextBlock Text="Відомості про себе" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="PersonalDetailsBox" Style="{StaticResource MultiLineBoxStyle}" Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#FF85A1" BorderThickness="2" CornerRadius="18" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#40FF2A55"/>
                        </Border.Effect>
                        <Grid>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFCE4" Offset="0.0"/>
                                        <GradientStop Color="#FFE4E1" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <DockPanel Margin="18">
                                <Button x:Name="BtnOpenChangePasswordWindow"
                                        DockPanel.Dock="Right"
                                        Content="🔑 Змінити пароль"
                                        Height="40"
                                        Background="#FF2A55"
                                        Foreground="White"
                                        Margin="16,0,0,0"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Command="{Binding ChangePasswordCommand}"/>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Зміна паролю" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Натисніть кнопку, щоб змінити пароль."
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#2D3436"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Button x:Name="BtnDeactivate" Content="🚫 Деактивувати акаунт" HorizontalAlignment="Left" Background="#D63031" Foreground="White" Style="{StaticResource ActionButtonStyle}" Command="{Binding DeactivateCommand}"/>

                <Button x:Name="BtnSave" Content="💾 Зберегти зміни" HorizontalAlignment="Right" Background="#FF2A55" Foreground="White" Style="{StaticResource ActionButtonStyle}" Command="{Binding SaveCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>