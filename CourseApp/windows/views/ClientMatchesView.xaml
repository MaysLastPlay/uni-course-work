<UserControl x:Class="CourseApp.windows.views.ClientMatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F8FA">

    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="BorderBrush" Value="#EAEAEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="White"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FFB3C3"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="White"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF4B72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="2,2,4,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Background="White"
                                BorderBrush="#EAEAEA"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0D000000"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FFB3C3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="💘 Пошук пари" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock x:Name="SubtitleText" Text="Підібрані кандидати за вашими критеріями пошуку" FontSize="12" Foreground="#7F8C8D" Margin="0,3,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Style="{StaticResource InputBoxStyle}"
                             ToolTip="Пошук за ім'ям або захопленнями"
                             TextChanged="Filter_Changed"/>

                    <CheckBox x:Name="MutualOnlyCheck"
                              Grid.Column="1"
                              Content="Лише взаємні збіги"
                              VerticalAlignment="Center"
                              Margin="16,0,12,0"
                              FontSize="12.5"
                              FontWeight="SemiBold"
                              Foreground="#2C3E50"
                              Cursor="Hand"
                              Checked="Filter_Changed"
                              Unchecked="Filter_Changed"/>

                    <Button Grid.Column="2"
                            Content="🔄 Оновити"
                            Background="#FFF0F3"
                            Foreground="#FF4B72"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="RefreshButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ListBox x:Name="MatchesListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource CardItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#FFF0F3" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <TextBlock Text="♥" FontSize="20" FontWeight="Bold" Foreground="#FF4B72" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding FullName}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                        <Border Background="#F2F4F7" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                        </Border>
                                        <Border Background="#FFF0F3" CornerRadius="6" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GenderText}" FontSize="11" FontWeight="SemiBold" Foreground="#FF4B72"/>
                                        </Border>
                                        <Border Background="#E8F8F0" CornerRadius="6" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding MutualBadgeVisibility}">
                                            <TextBlock Text="✨ Взаємний збіг" FontSize="11" FontWeight="Bold" Foreground="#27AE60"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding DetailsText}" FontSize="12.5" Foreground="#555" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="💌 Запросити"
                                        Background="#FF4B72"
                                        Foreground="White"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="InviteButton_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="EmptyMatchesPanel" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#10000000"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Кандидатів не знайдено" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                        <TextBlock Text="Спробуйте змінити віковий діапазон у профілі або зняти фільтр." FontSize="13" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="InviteOverlay" Background="#66000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="14" Padding="24" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#EAEAEA" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#28000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="💌 Запрошення на зустріч" FontSize="17" FontWeight="Bold" Foreground="#FF4B72" Margin="0,0,0,4"/>
                    <TextBlock x:Name="InviteTargetText" Text="" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Дата (дд.мм.рррр)*" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="InviteDateBox" Style="{StaticResource InputBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Час (гг:хх)*" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="InviteTimeBox" Style="{StaticResource InputBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Скасувати"
                                Background="#EAEAEA"
                                Foreground="#555"
                                Margin="0,0,10,0"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="CancelInvite_Click"/>
                        <Button Content="Надіслати"
                                Background="#FF4B72"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="ConfirmInvite_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>