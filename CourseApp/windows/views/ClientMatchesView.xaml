<UserControl x:Class="CourseApp.windows.views.ClientMatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="Background" Value="#FFF0F5"/>
            <Setter Property="BorderBrush" Value="#FF85A1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FFE4E1"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FFE4E1"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="2,2,4,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder" Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="2" CornerRadius="16" ClipToBounds="True" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Color="#30FF2A55"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#FFD3E2"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFC3A0" Offset="0.0"/>
                <GradientStop Color="#FFAFBD" Offset="0.4"/>
                <GradientStop Color="#D4A5FF" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="💘 З ким ви б хотіли познайомитись" FontSize="22" FontWeight="Bold" Foreground="#1E272E"/>
                <TextBlock Text="{Binding SubtitleText}" FontSize="12.5" FontWeight="Bold" Foreground="#2D3436" Margin="0,3,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="🔄 Оновити" Background="#FF2A55" Foreground="White" Style="{StaticResource ActionButtonStyle}" Command="{Binding RefreshCommand}"/>
                    <CheckBox Content="Лише взаємні збіги" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#1E272E" Cursor="Hand" IsChecked="{Binding MutualOnly}"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <ListBox ItemsSource="{Binding Matches}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource CardItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27" Background="#FFD6E0" BorderBrush="#FF85A1" BorderThickness="1.5" Margin="0,0,14,0" VerticalAlignment="Top" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="♥" FontSize="22" FontWeight="Bold" Foreground="#FF2A55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding AvatarPath}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding FullName}" FontSize="15" FontWeight="Bold" Foreground="#1E272E" VerticalAlignment="Center"/>
                                        <Border Background="#FFD6E0" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AgeText}" FontSize="11" FontWeight="Bold" Foreground="#FF2A55"/>
                                        </Border>
                                        <Border Background="#FFD6E0" CornerRadius="6" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GenderText}" FontSize="11" FontWeight="Bold" Foreground="#8E44AD"/>
                                        </Border>
                                        <Border Background="#55E6C1" CornerRadius="6" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding MutualBadgeVisibility}">
                                            <TextBlock Text="✨ Взаємний збіг" FontSize="11" FontWeight="Bold" Foreground="#1E272E"/>
                                        </Border>
                                    </WrapPanel>

                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#FFF0F5" CornerRadius="6" Padding="8,2" Margin="0,0,6,4" Visibility="{Binding HeightVisibility}">
                                            <TextBlock Text="{Binding HeightText}" FontSize="11" FontWeight="Bold" Foreground="#1E272E"/>
                                        </Border>
                                        <Border Background="#FFF0F5" CornerRadius="6" Padding="8,2" Margin="0,0,6,4" Visibility="{Binding WeightVisibility}">
                                            <TextBlock Text="{Binding WeightText}" FontSize="11" FontWeight="Bold" Foreground="#1E272E"/>
                                        </Border>
                                    </WrapPanel>

                                    <ItemsControl ItemsSource="{Binding Hobbies}" Margin="0,0,0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F3E8FF" BorderBrush="#C77DFF" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding StringFormat='🎯 {0}'}" FontSize="11" FontWeight="Bold" Foreground="#8E44AD"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding DetailsText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#2D3436" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="💌 Запросити" Background="#FF2A55" Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource ActionButtonStyle}" Command="{Binding DataContext.OpenInviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="2" CornerRadius="16" Padding="30" Visibility="{Binding EmptyMatchesVisibility}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="💘" FontSize="38" Foreground="#FF2A55" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Кандидатів поки немає" FontSize="16" FontWeight="Bold" Foreground="#1E272E" HorizontalAlignment="Center"/>
                        <TextBlock Text="Спробуйте зняти фільтр взаємних збігів або оновити список." FontSize="13" FontWeight="Bold" Foreground="#2D3436" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Background="#70000000" Visibility="{Binding InviteOverlayVisibility}">
            <Border Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="2" CornerRadius="16" Padding="24" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#40FF2A55"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="💌 Запрошення на зустріч" FontSize="17" FontWeight="Bold" Foreground="#FF2A55" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding InviteTargetText}" FontSize="13" FontWeight="Bold" Foreground="#1E272E" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Дата (дд.мм.рррр)*" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding InviteDate, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Час (гг:хх)*" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource InputBoxStyle}" Text="{Binding InviteTime, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Скасувати" Background="#FFB3C6" Foreground="#1E272E" Margin="0,0,10,0" Style="{StaticResource ActionButtonStyle}" Command="{Binding CancelInviteCommand}"/>
                        <Button Content="Надіслати" Background="#FF2A55" Foreground="White" Style="{StaticResource ActionButtonStyle}" Command="{Binding ConfirmInviteCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>