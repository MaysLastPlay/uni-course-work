<UserControl x:Class="CourseApp.windows.views.ArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F8FA">

    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="LocalComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFF0F3"/>
                                <Setter Property="Foreground" Value="#FF4B72"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFF0F3"/>
                                <Setter Property="Foreground" Value="#FF4B72"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource LocalComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="MainBorder"
                                                Background="#F7F8FA"
                                                BorderBrush="#EAEAEA"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                      Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="#7F8C8D"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MainBorder" Property="Background" Value="White"/>
                                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FFB3C3"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="#FF4B72"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="MainBorder" Property="Background" Value="White"/>
                                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF4B72"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="#FF4B72"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="12,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="#EAEAEA"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,4,0,8"
                                        Padding="0,3">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#18000000"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="4,2,6,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Background="White"
                                BorderBrush="#EAEAEA"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0D000000"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FFB3C3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF4B72"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#FFF9FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="5" BorderBrush="#EAEAEA" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,15">
                                <TabPanel IsItemsHost="True"/>
                            </Border>

                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="7" Padding="15,8" Margin="2,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFF0F3"/>
                                <Setter Property="Foreground" Value="#FF4B72"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FF4B72"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="📦 Archive Control Center" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Управління успішними парами, процес архівації та журнал вилучених акаунтів" FontSize="12" Foreground="#7F8C8D" Margin="0,3,0,0"/>
        </StackPanel>

        <TabControl x:Name="ArchiveTabControl" Grid.Row="1" Style="{StaticResource ModernTabControlStyle}" SelectionChanged="ArchiveTabControl_SelectionChanged">
            <TabItem Header="💍 Active Couples" Style="{StaticResource ModernTabItemStyle}">
                <Grid>
                    <ListBox x:Name="ActiveCouplesListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource CardItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" Background="#EBF5FB" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="💍" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Client1Name}" FontSize="14.5" FontWeight="Bold" Foreground="#2C3E50"/>
                                            <TextBlock Text="  ♥  " FontSize="14" FontWeight="Bold" Foreground="#FF4B72"/>
                                            <TextBlock Text="{Binding Client2Name}" FontSize="14.5" FontWeight="Bold" Foreground="#2C3E50"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding ArchiveDate, StringFormat='📅 Дата створення сім’ї: {0:dd.MM.yyyy}'}"
                                                   FontSize="12" Foreground="#7F8C8D"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#EBF5FB" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding StatusInfo}" FontSize="11.5" FontWeight="Bold" Foreground="#2980B9"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="EmptyCouplesPanel" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#10000000"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="💍" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Архів пар порожній" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Сформовані пари з'являться тут після перенесення до архіву." FontSize="13" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="📦 Move to Archive" Style="{StaticResource ModernTabItemStyle}">
                <Border Background="White" CornerRadius="12" Padding="25" HorizontalAlignment="Left" Width="520" VerticalAlignment="Top" BorderBrush="#EAEAEA" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0D000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Перенесення пари до архіву" FontSize="17" FontWeight="Bold" Foreground="#FF4B72" Margin="0,0,0,4"/>
                        <TextBlock Text="Оберіть двох активних клієнтів, які знайшли пару та завершують пошук." FontSize="12.5" Foreground="#7F8C8D" Margin="0,0,0,20"/>

                        <TextBlock Text="Перший партнер*" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="Client1ComboBox" Height="38" Margin="0,0,0,15" DisplayMemberPath="FullName"/>

                        <TextBlock Text="Другий партнер*" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="Client2ComboBox" Height="38" Margin="0,0,0,22" DisplayMemberPath="FullName"/>

                        <Button Content="💍 Сформувати пару та перенести в архів" Height="42" Background="#FF4B72" Foreground="White"
                                FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="MoveToArchive_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="🗑️ Deleted Clients" Style="{StaticResource ModernTabItemStyle}">
                <Grid>
                    <ListBox x:Name="DeletedClientsListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource CardItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" Background="#FDEDEC" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <TextBlock Text="🗑️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <DockPanel Margin="0,0,0,6">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#FDEDEC" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                    <TextBlock Text="Deleted" FontSize="11" FontWeight="Bold" Foreground="#C0392B"/>
                                                </Border>
                                                <Border Background="#F2F4F7" CornerRadius="6" Padding="8,3">
                                                    <TextBlock Text="{Binding RegNumber}" FontSize="11" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding FullName}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="#FFF0F3" CornerRadius="6" Padding="8,2" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Gender}" FontSize="11" FontWeight="SemiBold" Foreground="#FF4B72"/>
                                            </Border>

                                            <TextBlock Text="{Binding RegDate, StringFormat='📅 Реєстрація: {0:dd.MM.yyyy}'}"
                                                       FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Reason, StringFormat='Причина вилучення: {0}'}"
                                                   FontSize="12.5" Foreground="#C0392B" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <Button Content="♻️ Відновити"
                                                Height="34"
                                                Padding="12,0"
                                                Margin="0,0,8,0"
                                                Background="#E8F8F0"
                                                Foreground="#27AE60"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="RestoreClient_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="Background" Value="#27AE60"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Content="🗑️ Назавжди"
                                                Height="34"
                                                Padding="12,0"
                                                Background="#FDEDEC"
                                                Foreground="#C0392B"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="PermanentDeleteClient_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="DelBtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="DelBtnBorder" Property="Background" Value="#C0392B"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="EmptyDeletedPanel" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#10000000"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="✨" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Немає видалених клієнтів" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Деактивовані або вилучені акаунти відображатимуться тут." FontSize="13" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>