<UserControl x:Class="CourseApp.windows.views.ClientProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ModernComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFD6E0"/>
                                <Setter Property="Foreground" Value="#FF2A55"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFB3C6"/>
                                <Setter Property="Foreground" Value="#FF2A55"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="MainBorder" Background="#FFF0F5" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="#D63031" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MainBorder" Property="Background" Value="#FFE4E1"/>
                                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF2A55"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="MainBorder" Property="Background" Value="#FFE4E1"/>
                                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF2A55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="12,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,8" Padding="0,3">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#20FF2A55"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFC3A0" Offset="0.0"/>
                <GradientStop Color="#FFAFBD" Offset="0.4"/>
                <GradientStop Color="#D4A5FF" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="👥 Client Profiles — База клієнтів" FontSize="20" FontWeight="Bold" Foreground="#1E272E"/>
                    <TextBlock Text="Повний список усіх зареєстрованих клієнтів бюро знайомств" FontSize="12.5" FontWeight="Bold" Foreground="#2D3436" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Background="#FFD6E0" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="12" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtClientsCount" Text="{Binding CountText}" Foreground="#FF2A55" FontWeight="Bold" FontSize="12"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="#FFE4E1" CornerRadius="12" Padding="10" Margin="0,0,0,14" BorderBrush="#FF85A1" BorderThickness="1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFF0F5" CornerRadius="8" BorderBrush="#FF85A1" BorderThickness="1.5" Height="34">
                        <Grid>
                            <TextBox x:Name="SearchTextBox" Background="Transparent" BorderThickness="0" Padding="10,0" FontSize="13" Foreground="#1E272E" VerticalContentAlignment="Center" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="🔍 Пошук за ПІБ або реєстраційним номером..." Foreground="#2D3436" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <ComboBox x:Name="GenderFilterComboBox" Grid.Column="1" Width="120" Height="34" Margin="10,0,0,0" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="{Binding GenderIndex}">
                        <ComboBoxItem Content="Всі статі"/>
                        <ComboBoxItem Content="Чоловіча"/>
                        <ComboBoxItem Content="Жіноча"/>
                    </ComboBox>

                    <ComboBox x:Name="StatusFilterComboBox" Grid.Column="2" Width="125" Height="34" Margin="8,0,0,0" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="{Binding StatusIndex}">
                        <ComboBoxItem Content="Всі статуси"/>
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Archived"/>
                        <ComboBoxItem Content="Deleted"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ListBox x:Name="AllClientsListBox" ItemsSource="{Binding Clients}" Visibility="{Binding ListVisibility}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="4,2,6,10"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardBorder" Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="2" CornerRadius="16" ClipToBounds="True" Padding="16">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Color="#30FF2A55"/>
                                            </Border.Effect>
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#FFD3E2"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF2A55"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF2A55"/>
                                                <Setter TargetName="CardBorder" Property="Background" Value="#FFB3C6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" Background="#FFD6E0" BorderBrush="#FF85A1" BorderThickness="1.5" Margin="0,0,14,0" VerticalAlignment="Top" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="👤" FontSize="22" Foreground="#FF2A55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding AvatarPath}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#55E6C1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Archived">
                                                                <Setter Property="Background" Value="#F3E8FF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Deleted">
                                                                <Setter Property="Background" Value="#FF7675"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#1E272E"/>
                                            </Border>

                                            <Border Background="#FFD6E0" CornerRadius="6" Padding="8,3">
                                                <TextBlock Text="{Binding RegNumber}" FontSize="11" FontWeight="Bold" Foreground="#8E44AD"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontSize="15" FontWeight="Bold" Foreground="#1E272E" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Age, StringFormat=', {0} р.'}" FontSize="15" FontWeight="Bold" Foreground="#FF2A55"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#FFD6E0" CornerRadius="6" Padding="8,2" Margin="0,0,8,4">
                                            <TextBlock Text="{Binding Gender}" FontSize="11" FontWeight="Bold" Foreground="#FF2A55"/>
                                        </Border>

                                        <Border Background="#FFF0F5" CornerRadius="6" Padding="8,2" Margin="0,0,8,4">
                                            <TextBlock Text="{Binding HeightCm, StringFormat='📏 Зріст: {0} см'}" FontSize="11" FontWeight="Bold" Foreground="#1E272E">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HeightCm}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <Border Background="#FFF0F5" CornerRadius="6" Padding="8,2" Margin="0,0,8,4">
                                            <TextBlock Text="{Binding WeightKg, StringFormat='⚖️ Вага: {0} кг'}" FontSize="11" FontWeight="Bold" Foreground="#1E272E">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WeightKg}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Text="{Binding RegDate, StringFormat='📅 Реєстрація: {0:dd.MM.yyyy}'}" FontSize="12" FontWeight="Bold" Foreground="#2D3436" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                    </WrapPanel>

                                    <ItemsControl ItemsSource="{Binding Hobbies}" Margin="0,0,0,6">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F3E8FF" BorderBrush="#C77DFF" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding StringFormat='🎯 {0}'}" FontSize="11" FontWeight="Bold" Foreground="#8E44AD"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding PersonalDetails}" FontSize="12.5" FontWeight="Bold" Foreground="#2D3436" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PersonalDetails}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PersonalDetails}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{Binding PhotoPaths}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="64" Height="64" CornerRadius="8" BorderBrush="#FF85A1" BorderThickness="1" ClipToBounds="True" Margin="0,0,8,6">
                                                    <Image Source="{Binding}" Stretch="UniformToFill"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="EmptyStatePanel" Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="2" CornerRadius="16" Padding="30" Visibility="{Binding EmptyVisibility}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🔎" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Клієнтів не знайдено" FontSize="16" FontWeight="Bold" Foreground="#1E272E" HorizontalAlignment="Center"/>
                        <TextBlock Text="Спробуйте змінити параметри пошуку або фільтри." FontSize="13" FontWeight="Bold" Foreground="#2D3436" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>