<Window x:Class="CourseApp.windows.authentication.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CupidLove — Вхід до системи" Height="530" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandColor" Color="#FF2A55"/>
        <SolidColorBrush x:Key="BrandColorLight" Color="#FFD6E0"/>
        <SolidColorBrush x:Key="TextDark" Color="#1E272E"/>
        <SolidColorBrush x:Key="TextMuted" Color="#4A5568"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2D3436"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="Background" Value="#FFF0F5"/>
            <Setter Property="BorderBrush" Value="#FF85A1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FFE4E1"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FFE4E1"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordInputStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="Background" Value="#FFF0F5"/>
            <Setter Property="BorderBrush" Value="#FF85A1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PwdBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PwdBorder" Property="Background" Value="#FFE4E1"/>
                                <Setter TargetName="PwdBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PwdBorder" Property="Background" Value="#FFE4E1"/>
                                <Setter TargetName="PwdBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="{StaticResource BrandColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#FFD6E0"/>
            <Setter Property="Foreground" Value="#FF2A55"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#FF85A1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="#FFB3C6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFC3A0" Offset="0.0"/>
                <GradientStop Color="#FFAFBD" Offset="0.4"/>
                <GradientStop Color="#D4A5FF" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="28">
            <Border BorderBrush="#FF85A1"
                    BorderThickness="2"
                    CornerRadius="18"
                    ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#40FF2A55"/>
                </Border.Effect>

                <Grid>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFCE4" Offset="0.0"/>
                                <GradientStop Color="#FFE4E1" Offset="0.5"/>
                                <GradientStop Color="#FFD3E2" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Canvas IsHitTestVisible="False">
                        <Ellipse Width="200" Height="200" Fill="#FF2A55" Canvas.Left="-50" Canvas.Top="-50" Opacity="0.35">
                            <Ellipse.Effect>
                                <BlurEffect Radius="70"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="220" Height="220" Fill="#9B59B6" Canvas.Right="-60" Canvas.Bottom="-60" Opacity="0.35">
                            <Ellipse.Effect>
                                <BlurEffect Radius="75"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="130" Height="130" Fill="#FF7675" Canvas.Right="20" Canvas.Top="110" Opacity="0.25">
                            <Ellipse.Effect>
                                <BlurEffect Radius="55"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>

                    <StackPanel VerticalAlignment="Center" Margin="24">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="🎀" Foreground="{StaticResource BrandColor}" FontSize="28" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock Text="Lovers" Foreground="{StaticResource TextDark}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Увійдіть у свій акаунт або зареєструйтесь"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextMuted}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,22"/>

                        <TextBlock Text="Логін, Email або Реєстраційний номер" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtLogin" Style="{StaticResource InputBoxStyle}" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <TextBlock Text="Пароль" Style="{StaticResource FieldLabelStyle}"/>
                        <PasswordBox x:Name="TxtPassword" Style="{StaticResource PasswordInputStyle}" Margin="0,0,0,20"/>

                        <Button x:Name="BtnLogin"
                                Content="🔑 Увійти"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding LoginCommand}"
                                CommandParameter="{Binding ElementName=TxtPassword}"
                                Margin="0,0,0,10"/>

                        <Button x:Name="BtnRegister"
                                Content="📝 Зареєструвати новий акаунт"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RegisterCommand}"
                                Margin="0,0,0,12"/>

                        <TextBlock x:Name="TxtError"
                                   Text="{Binding Error}"
                                   Foreground="#D63031"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Visibility="{Binding ErrorVisibility}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>