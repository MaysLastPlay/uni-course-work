<Window x:Class="CourseApp.windows.authentication.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CupidLove — Вхід до системи" Height="520" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA"
        ResizeMode="NoResize"
        Loaded="LoginWindow_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandColor" Color="#FF4B72"/>
        <SolidColorBrush x:Key="BrandColorLight" Color="#FFF0F3"/>
        <SolidColorBrush x:Key="TextDark" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#EAEAEA"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="White"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FFB3C3"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="White"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF4B72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordInputStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PwdBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PwdBorder" Property="Background" Value="White"/>
                                <Setter TargetName="PwdBorder" Property="BorderBrush" Value="#FFB3C3"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PwdBorder" Property="Background" Value="White"/>
                                <Setter TargetName="PwdBorder" Property="BorderBrush" Value="#FF4B72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="{StaticResource BrandColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{StaticResource BrandColorLight}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandColor}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="#FFE2E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Border Background="White"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="26">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Color="#12000000"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="♥" Foreground="{StaticResource BrandColor}" FontSize="28" FontWeight="Bold" Margin="0,0,8,0"/>
                    <TextBlock Text="CupidLove" Foreground="{StaticResource TextDark}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Увійдіть у свій акаунт або зареєструйтесь"
                           FontSize="12.5"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,22"/>

                <TextBlock Text="Логін, Email або Реєстраційний номер" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="TxtLogin" Style="{StaticResource InputBoxStyle}" Margin="0,0,0,14"/>

                <TextBlock Text="Пароль" Style="{StaticResource FieldLabelStyle}"/>
                <PasswordBox x:Name="TxtPassword" Style="{StaticResource PasswordInputStyle}" Margin="0,0,0,20"/>

                <Button x:Name="BtnLogin" Content="🔑 Увійти" Style="{StaticResource PrimaryButtonStyle}" Click="BtnLogin_Click" Margin="0,0,0,10"/>

                <Button x:Name="BtnRegister" Content="📝 Зареєструвати новий акаунт" Style="{StaticResource SecondaryButtonStyle}" Click="BtnRegister_Click" Margin="0,0,0,12"/>

                <TextBlock x:Name="TxtError"
                           Text=""
                           Foreground="#C0392B"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>