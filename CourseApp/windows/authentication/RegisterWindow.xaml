<Window x:Class="CourseApp.windows.authentication.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CupidLove — Покрокова реєстрація" Height="540" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandColor" Color="#FF2A55"/>
        <SolidColorBrush x:Key="BrandColorLight" Color="#FFD6E0"/>
        <SolidColorBrush x:Key="TextDark" Color="#1E272E"/>
        <SolidColorBrush x:Key="TextMuted" Color="#2D3436"/>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF2A55"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="Background" Value="#FFF0F5"/>
            <Setter Property="BorderBrush" Value="#FF85A1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FFE4E1"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FFE4E1"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordInputStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="Background" Value="#FFF0F5"/>
            <Setter Property="BorderBrush" Value="#FF85A1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PwdBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PwdBorder" Property="Background" Value="#FFE4E1"/>
                                <Setter TargetName="PwdBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PwdBorder" Property="Background" Value="#FFE4E1"/>
                                <Setter TargetName="PwdBorder" Property="BorderBrush" Value="#FF2A55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LocalComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFD6E0"/>
                                <Setter Property="Foreground" Value="#FF2A55"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFB3C6"/>
                                <Setter Property="Foreground" Value="#FF2A55"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource LocalComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="MainBorder" Background="#FFF0F5" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="#D63031" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MainBorder" Property="Background" Value="#FFE4E1"/>
                                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF2A55"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="MainBorder" Property="Background" Value="#FFE4E1"/>
                                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF2A55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}" Margin="12,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0" Padding="0,3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFC3A0" Offset="0.0"/>
                <GradientStop Color="#FFAFBD" Offset="0.4"/>
                <GradientStop Color="#D4A5FF" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🎀" Foreground="#FF2A55" FontSize="26" FontWeight="Bold" Margin="0,0,8,0"/>
                    <TextBlock Text="Lovers" Foreground="#1E272E" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TxtAutoRegNumber" Text="{Binding RegLabel}" FontSize="11.5" Foreground="#8E44AD" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="12" Padding="12,8" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock x:Name="TxtStepTitle" Text="{Binding StepTitle}" FontSize="13" FontWeight="Bold" Foreground="#FF2A55" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStepDots" Text="{Binding StepDots}" FontSize="15" FontWeight="Bold" Foreground="#8E44AD" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" BorderBrush="#FF85A1" BorderThickness="2" CornerRadius="18" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#40FF2A55"/>
                </Border.Effect>
                <Grid>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFCE4" Offset="0.0"/>
                                <GradientStop Color="#FFE4E1" Offset="0.5"/>
                                <GradientStop Color="#FFD3E2" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Canvas IsHitTestVisible="False">
                        <Ellipse Width="200" Height="200" Fill="#FF2A55" Canvas.Left="-50" Canvas.Top="-50" Opacity="0.3">
                            <Ellipse.Effect>
                                <BlurEffect Radius="65"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="200" Height="200" Fill="#9B59B6" Canvas.Right="-50" Canvas.Bottom="-50" Opacity="0.3">
                            <Ellipse.Effect>
                                <BlurEffect Radius="65"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>

                    <Grid Margin="20">
                        <StackPanel x:Name="Step1Panel" Visibility="{Binding Step1Visibility}">
                            <TextBlock Text="1. Особисті дані" Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="ПІБ Клієнта*" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="FullNameTextBox" Style="{StaticResource InputBoxStyle}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Стать*" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="GenderComboBox" Height="38" SelectedIndex="{Binding GenderIndex}">
                                        <ComboBoxItem Content="Чоловіча"/>
                                        <ComboBoxItem Content="Жіноча"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Вік (від 18)*" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="AgeTextBox" Style="{StaticResource InputBoxStyle}" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="Step2Panel" Visibility="{Binding Step2Visibility}">
                            <TextBlock Text="2. Обліковий запис" Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Email адреса*" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="EmailTextBox" Style="{StaticResource InputBoxStyle}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                            <TextBlock Text="Пароль (мінімум 8 символів)*" Style="{StaticResource FieldLabelStyle}"/>
                            <PasswordBox x:Name="PasswordBoxField" Style="{StaticResource PasswordInputStyle}" Margin="0,0,0,14"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Button x:Name="BtnBack"
                        Content="{Binding BackText}"
                        HorizontalAlignment="Left"
                        Background="#FFB3C6"
                        Foreground="#1E272E"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding BackCommand}"/>
                <Button x:Name="BtnNext"
                        Content="{Binding NextText}"
                        HorizontalAlignment="Right"
                        Background="#FF2A55"
                        Foreground="White"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding NextCommand}"
                        CommandParameter="{Binding ElementName=PasswordBoxField}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>