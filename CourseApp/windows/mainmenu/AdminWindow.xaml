<Window x:Class="CourseApp.windows.mainmenu.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CupidLove — Бюро Знайомств (Адмін-панель)" Height="750" Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandColor" Color="#FF4B72"/>
        <SolidColorBrush x:Key="BrandColorLight" Color="#FFF0F3"/>
        <SolidColorBrush x:Key="TextDark" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#EAEAEA"/>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandColorLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#95A5A6"/>
            <Setter Property="Margin" Value="10,12,0,5"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="5,5,5,20">
                        <TextBlock Text="♥" Foreground="{StaticResource BrandColor}" FontSize="26" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="CupidLove" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="АВТОРИЗАЦІЯ" Style="{StaticResource MenuHeaderStyle}"/>
                    <Button x:Name="BtnLogin" Content="🔑 Login" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnRegister" Content="📝 Registration" Style="{StaticResource MenuButtonStyle}"/>

                    <Separator Background="{StaticResource BorderColor}" Margin="5,10"/>

                    <TextBlock Text="MAIN MENU" Style="{StaticResource MenuHeaderStyle}"/>
                    <Button x:Name="BtnSearchMatching" Content="🔍 Search &amp; Matching" Style="{StaticResource MenuButtonStyle}" Background="{StaticResource BrandColorLight}" Foreground="{StaticResource BrandColor}"/>
                    <Button x:Name="BtnMeetingMgmt" Content="📅 Meeting Management" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnClientProfiles" Content="👥 Client Profiles" Style="{StaticResource MenuButtonStyle}"/>

                    <Separator Background="{StaticResource BorderColor}" Margin="5,10"/>

                    <TextBlock Text="PROFILE MENU" Style="{StaticResource MenuHeaderStyle}"/>
                    <Button x:Name="BtnEditProfile" Content="✏️ Edit Profile" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnPartnerReqs" Content="🎯 Partner Requirements" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnDeactivate" Content="🚫 Deactivate Account" Style="{StaticResource MenuButtonStyle}" Foreground="#E74C3C"/>

                    <Separator Background="{StaticResource BorderColor}" Margin="5,10"/>

                    <TextBlock Text="ARCHIVE &amp; DELETION" Style="{StaticResource MenuHeaderStyle}"/>
                    <Button x:Name="BtnActiveCouples" Content="💍 Active Couples" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnMoveArchive" Content="📦 Move to Archive" Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="BtnDeletedClients" Content="🗑️ Deleted Clients" Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Search &amp; Matching: Підбір кандидатів" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                <TextBlock Text="Виберіть підмножину підходящих кандидатур відповідно до вимог клієнта" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,3,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Поточний клієнт (замовник):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CurrentClientComboBox" Width="220" Height="30" DisplayMemberPath="FullName"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Color="#10000000"/>
                </Border.Effect>
                <DataGrid x:Name="CandidatesDataGrid" 
                          AutoGenerateColumns="True" 
                          CanUserAddRows="False" 
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Background="Transparent" 
                          BorderBrush="Transparent" 
                          RowHeight="45"/>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="BtnCreateMeeting" 
                        Content="📅 Сформувати запрошення на зустріч" 
                        Width="265" Height="42" 
                        Background="#2ECC71" 
                        Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Відомості та Вимоги" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,10,0,15"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <StackPanel>
                        <Ellipse Width="90" Height="90" Margin="0,0,0,15" HorizontalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="https://picsum.photos/id/338/200/200" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <TextBlock Text="Анна Ковальчук" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextDark}"/>
                        <TextBlock Text="REG-045 • Реєстрація: 12.02.2026" FontSize="11" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,2,0,15"/>

                        <Border Background="#F9FAFB" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📖 Відомості про себе:" FontWeight="Bold" FontSize="12" Foreground="#333" Margin="0,0,0,5"/>
                                <TextBlock Text="Архітектор, люблю активний відпочинок, подорожі та ранкову каву. Шукаю надійну людину для створення сім'ї." 
                                           FontSize="12" Foreground="#666" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BrandColorLight}" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="🎯 Вимоги до партнера:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrandColor}" Margin="0,0,0,5"/>
                                <TextBlock Text="• Бажана стать: Чоловіча&#x0a;• Вік: від 26 до 35 років&#x0a;• Критерії: Ввічливий, без шкідливих звичок, з вищою освітою." 
                                           FontSize="12" Foreground="#555" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                    <Button x:Name="BtnArchiveCouple" 
                            Content="💍 Перенести пару в архів" 
                            Height="36" Background="#3498DB" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Margin="0,0,0,8"/>

                    <Button x:Name="BtnDeleteClient" 
                            Content="🗑️ Видалити клієнта (відмова)" 
                            Height="36" Background="#FADBD8" Foreground="#C0392B" 
                            Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
