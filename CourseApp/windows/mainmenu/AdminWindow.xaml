<Window x:Class="CourseApp.windows.mainmenu.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:CourseApp.classes.enums"
        Title="CupidLove — Бюро Знайомств (Адмін-панель)"
        Height="750"
        Width="1260"
        MinHeight="640"
        MinWidth="1020"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandColor" Color="#FF2A55"/>
        <SolidColorBrush x:Key="BrandColorLight" Color="#FFD6E0"/>
        <SolidColorBrush x:Key="TextDark" Color="#1E272E"/>
        <SolidColorBrush x:Key="TextMuted" Color="#2D3436"/>
        <SolidColorBrush x:Key="BorderColor" Color="#FF85A1"/>

        <Style x:Key="LocalComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFD6E0"/>
                                <Setter Property="Foreground" Value="#FF2A55"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFB3C6"/>
                                <Setter Property="Foreground" Value="#FF2A55"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1E272E"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource LocalComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="MainBorder"
                                                Background="#FFF0F5"
                                                BorderBrush="#FF85A1"
                                                BorderThickness="1.5"
                                                CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                      Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="#D63031"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MainBorder" Property="Background" Value="#FFE4E1"/>
                                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF2A55"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="MainBorder" Property="Background" Value="#FFE4E1"/>
                                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF2A55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="12,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border Background="#FFE4E1"
                                        BorderBrush="#FF85A1"
                                        BorderThickness="1.5"
                                        CornerRadius="9"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,4,0,0"
                                        Padding="0,3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#70FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FF85A1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#2D3436"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF0F5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF85A1"/>
                                <Setter Property="Foreground" Value="#FF2A55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8E44AD"/>
            <Setter Property="Margin" Value="4,10,0,6"/>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#FFF0F5"/>
            <Setter Property="Foreground" Value="#D63031"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#FF85A1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#D63031"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#D63031"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFC3A0" Offset="0.0"/>
                <GradientStop Color="#FFAFBD" Offset="0.4"/>
                <GradientStop Color="#D4A5FF" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="255"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#FF85A1" BorderThickness="0,0,2,0" ClipToBounds="True">
            <Grid>
                <Border Background="#FFFCE4" Opacity="0.84"/>
                <Canvas IsHitTestVisible="False">
                    <Ellipse Width="180" Height="180" Fill="#FF2A55" Canvas.Left="-50" Canvas.Top="-50" Opacity="0.25">
                        <Ellipse.Effect>
                            <BlurEffect Radius="60"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="180" Height="180" Fill="#9B59B6" Canvas.Right="-50" Canvas.Bottom="-50" Opacity="0.25">
                        <Ellipse.Effect>
                            <BlurEffect Radius="60"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <Grid Margin="16,18,16,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎀" Foreground="#FF2A55" FontSize="26" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock Text="Lovers" FontSize="22" FontWeight="Bold" Foreground="#1E272E" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Панель адміністратора" FontSize="11.5" FontWeight="Bold" Foreground="#2D3436" Margin="2,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="14" Padding="12" Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#20FF2A55"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="👑 Адміністратор" FontSize="13.5" FontWeight="Bold" Foreground="#1E272E"/>
                            <TextBlock x:Name="TxtAdminStats" Text="{Binding StatsText}" FontSize="11" FontWeight="Bold" Foreground="#FF2A55" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel>
                            <TextBlock Text="ГОЛОВНЕ МЕНЮ" Style="{StaticResource MenuHeaderStyle}" Margin="4,0,0,6"/>

                            <Button x:Name="BtnSearchMatching" Content="💘  Підбір кандидатів"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static enums:AdminNavSection.SearchMatching}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Section}" Value="{x:Static enums:AdminNavSection.SearchMatching}">
                                                <Setter Property="Background" Value="{StaticResource BrandColor}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrandColor}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnMeetingMgmt" Content="📅  Управління зустрічами"
                                    Style="{StaticResource MenuButtonStyle}"
                                    Command="{Binding OpenMeetingsCommand}"/>

                            <Button x:Name="BtnClientProfiles" Content="👥  База клієнтів"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static enums:AdminNavSection.ClientProfiles}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Section}" Value="{x:Static enums:AdminNavSection.ClientProfiles}">
                                                <Setter Property="Background" Value="{StaticResource BrandColor}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrandColor}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnRegister" Content="📝  Додати клієнта"
                                    Style="{StaticResource MenuButtonStyle}"
                                    Command="{Binding RegisterCommand}"/>

                            <Border Height="1" Background="#40FF85A1" Margin="0,6,0,6"/>

                            <TextBlock Text="ПРОФІЛЬ КЛІЄНТА" Style="{StaticResource MenuHeaderStyle}"/>

                            <Button x:Name="BtnEditProfile" Content="✏️  Редагувати профіль"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static enums:AdminNavSection.EditProfile}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Section}" Value="{x:Static enums:AdminNavSection.EditProfile}">
                                                <Setter Property="Background" Value="{StaticResource BrandColor}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrandColor}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Border Height="1" Background="#40FF85A1" Margin="0,6,0,6"/>

                            <TextBlock Text="АРХІВ ТА ВИЛУЧЕННЯ" Style="{StaticResource MenuHeaderStyle}"/>

                            <Button x:Name="BtnActiveCouples" Content="💍  Активні пари"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static enums:AdminNavSection.ActiveCouples}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Section}" Value="{x:Static enums:AdminNavSection.ActiveCouples}">
                                                <Setter Property="Background" Value="{StaticResource BrandColor}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrandColor}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnMoveArchive" Content="📦  Перенести в архів"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static enums:AdminNavSection.MoveArchive}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Section}" Value="{x:Static enums:AdminNavSection.MoveArchive}">
                                                <Setter Property="Background" Value="{StaticResource BrandColor}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrandColor}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="BtnDeletedClients" Content="🗑️  Видалені клієнти"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static enums:AdminNavSection.DeletedClients}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Section}" Value="{x:Static enums:AdminNavSection.DeletedClients}">
                                                <Setter Property="Background" Value="{StaticResource BrandColor}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrandColor}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Button x:Name="BtnLogin" Grid.Row="3" Content="🚪  Вийти з панелі" Style="{StaticResource LogoutButtonStyle}" Command="{Binding LogoutCommand}" Margin="0,12,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid x:Name="SearchMatchingView" Visibility="{Binding SearchVisibility}" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="💘 Підбір кандидатів" FontSize="22" FontWeight="Bold" Foreground="#1E272E"/>
                    <TextBlock Text="Оберіть клієнта, щоб переглянути відповідні анкети та організувати зустріч" FontSize="12.5" FontWeight="Bold" Foreground="#2D3436" Margin="0,3,0,12"/>

                    <Border Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="12" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Поточний клієнт:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E272E" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CurrentClientComboBox" Grid.Column="1" Height="36" Margin="0,0,12,0"
                                      ItemsSource="{Binding ActiveClients}" SelectedItem="{Binding ActiveClient}"/>

                            <Border Grid.Column="2" Background="#FFD6E0" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCandidatesCount" Text="{Binding CandidatesCount}" Foreground="#FF2A55" FontWeight="Bold" FontSize="12"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1">
                    <ListBox x:Name="CandidatesListBox"
                             ItemsSource="{Binding Candidates}"
                             SelectedItem="{Binding SelectedCandidate}"
                             Visibility="{Binding CandidatesVisibility}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="4,2,6,10"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBorder"
                                                    Background="#FFE4E1"
                                                    BorderBrush="#FF85A1"
                                                    BorderThickness="2"
                                                    CornerRadius="16"
                                                    ClipToBounds="True"
                                                    Padding="16">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Color="#30FF2A55"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Canvas IsHitTestVisible="False">
                                                        <Ellipse Width="100" Height="100" Fill="#FF2A55" Canvas.Right="-20" Canvas.Top="-20" Opacity="0.18">
                                                            <Ellipse.Effect>
                                                                <BlurEffect Radius="35"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                    </Canvas>
                                                    <ContentPresenter/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#FFD3E2"/>
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF2A55"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF2A55"/>
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#FFB3C6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27" Background="#FFD6E0" BorderBrush="#FF85A1" BorderThickness="1.5" Margin="0,0,14,0" VerticalAlignment="Top" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="♥" FontSize="22" Foreground="#FF2A55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding AvatarPath}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <DockPanel Margin="0,0,0,6">
                                            <Border DockPanel.Dock="Right" Background="#FFD6E0" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RegNumber}" FontSize="11" FontWeight="Bold" Foreground="#8E44AD"/>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontSize="15.5" FontWeight="Bold" Foreground="#1E272E"/>
                                                <TextBlock Text="{Binding Age, StringFormat=', {0} р.'}" FontSize="15.5" FontWeight="Bold" Foreground="#FF2A55"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="#FFD6E0" CornerRadius="6" Padding="8,2" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding Gender}" FontSize="11" FontWeight="Bold" Foreground="#FF2A55"/>
                                            </Border>
                                            <Border Background="#55E6C1" CornerRadius="6" Padding="8,2" Margin="0,0,6,4">
                                                <TextBlock Text="✨ Рекомендована пара" FontSize="11" FontWeight="Bold" Foreground="#1E272E"/>
                                            </Border>
                                            <Border Background="#FFF0F5" CornerRadius="6" Padding="8,2" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding HeightCm, StringFormat='📏 {0} см'}" FontSize="11" FontWeight="Bold" Foreground="#1E272E">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HeightCm}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <Border Background="#FFF0F5" CornerRadius="6" Padding="8,2" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding WeightKg, StringFormat='⚖️ {0} кг'}" FontSize="11" FontWeight="Bold" Foreground="#1E272E">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding WeightKg}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </WrapPanel>

                                        <ItemsControl ItemsSource="{Binding Hobbies}" Margin="0,0,0,4">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F3E8FF" BorderBrush="#C77DFF" BorderThickness="1" CornerRadius="8" Padding="7,2" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding StringFormat='🎯 {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="#8E44AD"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding PersonalDetails}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2D3436"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="42"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="EmptyStatePanel" Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="2" CornerRadius="16" Padding="30" Visibility="{Binding EmptyVisibility}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="💔" FontSize="40" Foreground="#FF2A55" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Поки що немає підходящих кандидатів" FontSize="16" FontWeight="Bold" Foreground="#1E272E" HorizontalAlignment="Center"/>
                            <TextBlock Text="Для обраного клієнта не знайдено збігів за заданими критеріями." FontSize="13" FontWeight="SemiBold" Foreground="#2D3436" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="BtnCreateMeeting"
                            Content="📅 Сформувати запрошення на зустріч"
                            Height="42"
                            Background="#00B894"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding InviteCommand}"/>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="ActiveViewHost" Content="{Binding CurrentView}" Visibility="{Binding HostVisibility}"/>
        </Grid>

        <Border Grid.Column="2" BorderBrush="#FF85A1" BorderThickness="2,0,0,0" ClipToBounds="True">
            <Grid>
                <Border Background="#FFFCE4" Opacity="0.86"/>
                <Canvas IsHitTestVisible="False">
                    <Ellipse Width="200" Height="200" Fill="#C77DFF" Canvas.Right="-50" Canvas.Top="-50" Opacity="0.25">
                        <Ellipse.Effect>
                            <BlurEffect Radius="70"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Відомості та Вимоги" FontSize="16" FontWeight="Bold" Foreground="#1E272E" Margin="0,4,0,14"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel>
                            <Border Width="88" Height="88" CornerRadius="44" Background="#FFD6E0" BorderBrush="#FF85A1" BorderThickness="2" Margin="0,0,0,12" HorizontalAlignment="Center" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="PreviewInitials" Text="{Binding PreviewInitials}" Visibility="{Binding PreviewInitialsVisibility}" FontSize="30" FontWeight="Bold" Foreground="#FF2A55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="PreviewAvatarImage" Source="{Binding PreviewAvatar}" Visibility="{Binding PreviewAvatarVisibility}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="PreviewFullName" Text="{Binding PreviewName}" FontSize="16.5" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="#1E272E"/>
                            <TextBlock x:Name="PreviewMeta" Text="{Binding PreviewMeta}" FontSize="11" FontWeight="Bold" Foreground="#8E44AD" HorizontalAlignment="Center" Margin="0,3,0,12"/>

                            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Border x:Name="PreviewHeightBorder" Background="#FFF0F5" BorderBrush="#FF85A1" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="3" Visibility="{Binding PreviewHeightVisibility}">
                                    <TextBlock x:Name="PreviewHeightText" Text="{Binding PreviewHeight}" FontSize="11" FontWeight="Bold" Foreground="#1E272E"/>
                                </Border>
                                <Border x:Name="PreviewWeightBorder" Background="#FFF0F5" BorderBrush="#FF85A1" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="3" Visibility="{Binding PreviewWeightVisibility}">
                                    <TextBlock x:Name="PreviewWeightText" Text="{Binding PreviewWeight}" FontSize="11" FontWeight="Bold" Foreground="#1E272E"/>
                                </Border>
                            </WrapPanel>

                            <Border Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="📖 Відомості про себе:" FontWeight="Bold" FontSize="12" Foreground="#1E272E" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="PreviewDetails" Text="{Binding PreviewDetails}" FontSize="12" FontWeight="SemiBold" Foreground="#2D3436" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="PreviewHobbiesCard" Background="#FFF0F5" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="12" Padding="12" Margin="0,0,0,10" Visibility="{Binding PreviewHobbiesVisibility}">
                                <StackPanel>
                                    <TextBlock Text="🎯 Хобі:" FontWeight="Bold" FontSize="12" Foreground="#FF2A55" Margin="0,0,0,6"/>
                                    <ItemsControl x:Name="PreviewHobbiesControl" ItemsSource="{Binding PreviewHobbies}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F3E8FF" BorderBrush="#C77DFF" BorderThickness="1" CornerRadius="8" Padding="7,2" Margin="0,0,5,5">
                                                    <TextBlock Text="{Binding}" FontSize="11" FontWeight="Bold" Foreground="#8E44AD"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="#F3E8FF" BorderBrush="#C77DFF" BorderThickness="1.5" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="🎯 Вимоги до партнера:" FontWeight="Bold" FontSize="12" Foreground="#8E44AD" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="PreviewRequirements" Text="{Binding PreviewReqs}" FontSize="12" FontWeight="SemiBold" Foreground="#2D3436" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Button x:Name="BtnArchiveCouple"
                                Content="💍 Перенести пару в архів"
                                Height="38"
                                Background="#0984E3"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding ArchiveCommand}"
                                Margin="0,0,0,8"/>

                        <Button x:Name="BtnDeleteClient"
                                Content="🗑️ Видалити клієнта (відмова)"
                                Height="38"
                                Background="#D63031"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>