<Window x:Class="CourseApp.windows.mainmenu.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CupidLove — Кабінет клієнта"
        Height="720"
        Width="1120"
        MinHeight="600"
        MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandColor" Color="#FF4B72"/>
        <SolidColorBrush x:Key="BrandColorLight" Color="#FFF0F3"/>
        <SolidColorBrush x:Key="TextDark" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#EAEAEA"/>

        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="ClientNavigation"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="Transparent"
                                CornerRadius="10"
                                Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#FFF0F3"/>
                                <Setter Property="Foreground" Value="#FF4B72"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#FF4B72"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#FDEDEC"/>
            <Setter Property="Foreground" Value="#C0392B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#C0392B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,1,0"
                Padding="18,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="♥" Foreground="{StaticResource BrandColor}" FontSize="24" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="CupidLove" Foreground="{StaticResource TextDark}" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Особистий кабінет клієнта" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="2,3,0,0"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{StaticResource BrandColorLight}"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock x:Name="ClientNameText"
                                   Text="Клієнт"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDark}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ClientMetaText"
                                   Text="REG-000"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandColor}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2">
                    <RadioButton x:Name="NavMatches" Style="{StaticResource SidebarNavButtonStyle}" Checked="NavMatches_Checked">
                        <Grid>
                            <TextBlock Text="💘  Пошук пари" VerticalAlignment="Center"/>
                            <Border x:Name="MatchesBadge" Background="#FFF0F3" CornerRadius="10" Padding="7,1" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="MatchesBadgeText" Text="0" FontSize="11" FontWeight="Bold" Foreground="#FF4B72"/>
                            </Border>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavMeetings" Style="{StaticResource SidebarNavButtonStyle}" Checked="NavMeetings_Checked">
                        <Grid>
                            <TextBlock Text="📅  Мої зустрічі" VerticalAlignment="Center"/>
                            <Border x:Name="MeetingsBadge" Background="#FFF0F3" CornerRadius="10" Padding="7,1" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="MeetingsBadgeText" Text="0" FontSize="11" FontWeight="Bold" Foreground="#FF4B72"/>
                            </Border>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavProfile" Content="✏️  Мій профіль" Style="{StaticResource SidebarNavButtonStyle}" Checked="NavProfile_Checked"/>
                </StackPanel>

                <Button Grid.Row="3"
                        x:Name="BtnLogout"
                        Content="🚪  Вийти з акаунту"
                        Style="{StaticResource LogoutButtonStyle}"
                        Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" x:Name="MainContent"/>
    </Grid>
</Window>