<Window x:Class="CourseApp.windows.mainmenu.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CupidLove — Кабінет клієнта"
        Height="720"
        Width="1120"
        MinHeight="600"
        MinWidth="920"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandColor" Color="#FF2A55"/>
        <SolidColorBrush x:Key="BrandColorLight" Color="#FFD6E0"/>
        <SolidColorBrush x:Key="TextDark" Color="#1E272E"/>
        <SolidColorBrush x:Key="TextMuted" Color="#2D3436"/>

        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2D3436"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="ClientNavigation"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="#70FFFFFF"
                                BorderBrush="#40FF85A1"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="12,0"
                                Margin="0">
                            <Grid>
                                <Border x:Name="ActiveIndicator"
                                        Width="4"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        Background="#FF2A55"
                                        Margin="-12,6,0,6"
                                        Opacity="0"/>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#FFF0F5"/>
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#FF85A1"/>
                                <Setter Property="Foreground" Value="#FF2A55"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#FF2A55"/>
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#FF2A55"/>
                                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                                <Setter TargetName="ActiveIndicator" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#FFF0F5"/>
            <Setter Property="Foreground" Value="#D63031"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#FF85A1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#D63031"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#D63031"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFC3A0" Offset="0.0"/>
                <GradientStop Color="#FFAFBD" Offset="0.4"/>
                <GradientStop Color="#D4A5FF" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#FF85A1" BorderThickness="0,0,2,0" ClipToBounds="True">
            <Grid>
                <Border Background="#FFFCE4" Opacity="0.82"/>

                <Canvas IsHitTestVisible="False">
                    <Ellipse Width="180" Height="180" Fill="#FF2A55" Canvas.Left="-40" Canvas.Top="-40" Opacity="0.25">
                        <Ellipse.Effect>
                            <BlurEffect Radius="60"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="180" Height="180" Fill="#C77DFF" Canvas.Right="-40" Canvas.Bottom="-40" Opacity="0.25">
                        <Ellipse.Effect>
                            <BlurEffect Radius="60"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <Grid Margin="18,20,18,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎀" Foreground="#FF2A55" FontSize="26" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock Text="Lovers" Foreground="#1E272E" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Особистий кабінет клієнта" FontSize="11.5" FontWeight="Bold" Foreground="#2D3436" Margin="2,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="14" Padding="12" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#20FF2A55"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="#1E272E" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Meta}" FontSize="11.5" FontWeight="Bold" Foreground="#FF2A55" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="НАВІГАЦІЯ" FontSize="10.5" FontWeight="Bold" Foreground="#8E44AD" Margin="4,0,0,8"/>

                            <RadioButton Content="💘  Рекомендації" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="True" Command="{Binding MatchesCommand}"/>
                            <RadioButton Content="🔍  Пошук" Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding SearchCommand}"/>
                            <RadioButton Content="📅  Мої зустрічі" Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding MeetingsCommand}"/>

                            <Border Height="1" Background="#40FF85A1" Margin="0,10,0,14"/>

                            <TextBlock Text="ОБЛІКОВИЙ ЗАПИС" FontSize="10.5" FontWeight="Bold" Foreground="#8E44AD" Margin="4,0,0,8"/>

                            <RadioButton Content="✏️  Мій профіль" Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding ProfileCommand}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="3" Content="🚪  Вийти з акаунту" Style="{StaticResource LogoutButtonStyle}" Command="{Binding LogoutCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <ContentControl Content="{Binding ActiveView}"/>
        </Grid>
    </Grid>
</Window>