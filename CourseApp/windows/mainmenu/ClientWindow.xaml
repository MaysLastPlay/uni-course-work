<Window x:Class="CourseApp.windows.mainmenu.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CupidLove — Особистий кабінет" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandColor" Color="#FF4B72"/>
        <SolidColorBrush x:Key="BrandColorLight" Color="#FFF0F3"/>
        <SolidColorBrush x:Key="TextDark" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#EAEAEA"/>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandColorLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#95A5A6"/>
            <Setter Property="Margin" Value="10,12,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
            <StackPanel Margin="12">
                <StackPanel Orientation="Horizontal" Margin="5,5,5,30">
                    <TextBlock Text="♥" Foreground="{StaticResource BrandColor}" FontSize="24" FontWeight="Bold" Margin="0,0,8,0"/>
                    <TextBlock Text="CupidLove" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="ОСНОВНЕ" Style="{StaticResource MenuHeaderStyle}"/>
                <Button x:Name="BtnMyCandidates" Content="🔍 Мої кандидати" Style="{StaticResource MenuButtonStyle}" Background="{StaticResource BrandColorLight}" Foreground="{StaticResource BrandColor}"/>
                <Button x:Name="BtnMyMeetings" Content="📅 Мої зустрічі" Style="{StaticResource MenuButtonStyle}"/>
                <Button x:Name="BtnMessages" Content="💬 Повідомлення" Style="{StaticResource MenuButtonStyle}"/>

                <Separator Background="{StaticResource BorderColor}" Margin="5,15"/>

                <TextBlock Text="НАЛАШТУВАННЯ" Style="{StaticResource MenuHeaderStyle}"/>
                <Button x:Name="BtnEditProfile" Content="✏️ Редагувати профіль" Style="{StaticResource MenuButtonStyle}"/>
                <Button x:Name="BtnLogout" Content="🚪 Вийти" Style="{StaticResource MenuButtonStyle}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Рекомендовані кандидати" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                <TextBlock Text="Люди, які відповідають вашим вимогам." FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Color="#10000000"/>
                </Border.Effect>
                <DataGrid x:Name="CandidatesDataGrid" 
                          AutoGenerateColumns="True" 
                          CanUserAddRows="False" 
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Background="Transparent" 
                          BorderBrush="Transparent" 
                          RowHeight="45"/>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0">
            <StackPanel Margin="20">
                <TextBlock Text="Мій профіль" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>

                <Ellipse Width="100" Height="100" Margin="0,0,0,15" HorizontalAlignment="Center">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="https://picsum.photos/id/1005/200/200" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>

                <TextBlock x:Name="TxtFullName" Text="Ім'я Користувача" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextDark}"/>
                <TextBlock x:Name="TxtRegNumber" Text="REG-000" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,20"/>

                <Border Background="#F9FAFB" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Про мене:" FontWeight="Bold" FontSize="12" Foreground="#333" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtPersonalDetails" Text="Тут буде ваш опис..." FontSize="13" Foreground="#555" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <Button x:Name="BtnProposeMeeting" 
                        Content="📅 Запропонувати зустріч" 
                        Height="45" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,20,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>