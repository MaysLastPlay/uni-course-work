<Window x:Class="CourseApp.windows.mainmenu.MeetingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mvvm="clr-namespace:CourseApp.classes.mvvm.viewmodels"
        xmlns:enum="clr-namespace:CourseApp.classes.enums"
        Title="CupidLove — Управління зустрічами" Height="600" Width="820"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FilterPillStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#2D3436"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="MeetingStatusFilter"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder" Background="Transparent" CornerRadius="8" Padding="14,7" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#FFD6E0"/>
                                <Setter Property="Foreground" Value="#FF2A55"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#FF2A55"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFC3A0" Offset="0.0"/>
                <GradientStop Color="#FFAFBD" Offset="0.4"/>
                <GradientStop Color="#D4A5FF" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding TitleText}" FontSize="22" FontWeight="Bold" Foreground="#1E272E"/>
                    <TextBlock Text="Оберіть запрошення, щоб підтвердити або відхилити зустріч" FontSize="12.5" FontWeight="Bold" Foreground="#2D3436" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Background="#FFD6E0" BorderBrush="#FF85A1" BorderThickness="1.5" CornerRadius="12" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MeetingsCountText}" Foreground="#FF2A55" FontWeight="Bold" FontSize="12"/>
                </Border>
            </Grid>
            <Border Grid.Row="1" Background="#FFF0F5" CornerRadius="10" Padding="5" BorderBrush="#FF85A1" BorderThickness="1.5" HorizontalAlignment="Left" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Всі"
                                 IsChecked="True"
                                 Style="{StaticResource FilterPillStyle}"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="{x:Static enum:MeetingFilterMode.All}"/>
                    <RadioButton Content="⏳ Pending"
                                 Style="{StaticResource FilterPillStyle}"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="{x:Static enum:MeetingFilterMode.Pending}"/>
                    <RadioButton Content="✅ Accepted"
                                 Style="{StaticResource FilterPillStyle}"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="{x:Static enum:MeetingFilterMode.Accepted}"/>
                    <RadioButton Content="❌ Rejected"
                                 Style="{StaticResource FilterPillStyle}"
                                 Command="{Binding SetFilterCommand}"
                                 CommandParameter="{x:Static enum:MeetingFilterMode.Rejected}"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2">
                <ListBox ItemsSource="{Binding FilteredMeetings}"
                         SelectedItem="{Binding SelectedMeeting}"
                         Visibility="{Binding ListVisibility}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="4,2,6,10"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardBorder"
                                                Background="#FFE4E1"
                                                BorderBrush="#FF85A1"
                                                BorderThickness="2"
                                                CornerRadius="16"
                                                ClipToBounds="True"
                                                Padding="16">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Direction="270" Color="#30FF2A55"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Canvas IsHitTestVisible="False">
                                                    <Ellipse Width="120" Height="120" Fill="#FF2A55" Canvas.Right="-30" Canvas.Bottom="-30" Opacity="0.2">
                                                        <Ellipse.Effect>
                                                            <BlurEffect Radius="40"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Canvas>
                                                <ContentPresenter/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#FFD3E2"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF2A55"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF2A55"/>
                                                <Setter TargetName="CardBorder" Property="Background" Value="#FFB3C6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" Background="#FFD6E0" BorderBrush="#FF85A1" BorderThickness="1.5" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="💌" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="{Binding Initiator.FullName}" FontSize="15" FontWeight="Bold" Foreground="#1E272E"/>
                                        <TextBlock Text="  →  " FontSize="14" FontWeight="Bold" Foreground="#FF2A55"/>
                                        <TextBlock Text="{Binding Target.FullName}" FontSize="15" FontWeight="Bold" Foreground="#1E272E"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding MeetingDate, StringFormat='🗓️ Заплановано: {0:dd.MM.yyyy HH:mm}'}"
                                               FontSize="12" FontWeight="Bold" Foreground="#2D3436"/>
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="8" Padding="12,5" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFEAA7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Accepted">
                                                    <Setter Property="Background" Value="#55E6C1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                    <Setter Property="Background" Value="#FF7675"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#D63031"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Accepted">
                                                        <Setter Property="Foreground" Value="#1E272E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Background="#FFE4E1" BorderBrush="#FF85A1" BorderThickness="2" CornerRadius="16" Padding="30" Visibility="{Binding EmptyVisibility}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📅" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Немає запрошень на зустрічі" FontSize="16" FontWeight="Bold" Foreground="#1E272E" HorizontalAlignment="Center"/>
                        <TextBlock Text="Сформуйте нове запрошення у розділі пошуку кандидатів або змініть фільтр." FontSize="13" FontWeight="Bold" Foreground="#2D3436" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="✅ Прийняти" Width="135" Height="40" Background="#00B894" Foreground="White" Margin="0,0,10,0" Style="{StaticResource ActionButtonStyle}" Command="{Binding AcceptCommand}"/>
                <Button Content="❌ Відхилити" Width="135" Height="40" Background="#D63031" Foreground="White" Margin="0,0,10,0" Style="{StaticResource ActionButtonStyle}" Command="{Binding RejectCommand}"/>
                <Button Content="Закрити" Width="105" Height="40" Background="#FFB3C6" Foreground="#1E272E" Style="{StaticResource ActionButtonStyle}" Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>