<Window x:Class="CourseApp.windows.mainmenu.MeetingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CupidLove — Управління зустрічами" Height="600" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FilterPillStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="MeetingStatusFilter"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder" Background="Transparent" CornerRadius="7" Padding="14,7" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#FFF0F3"/>
                                <Setter Property="Foreground" Value="#FF4B72"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#FF4B72"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Text="📅 Управління зустрічами" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Оберіть запрошення, щоб підтвердити або відхилити зустріч" FontSize="12.5" Foreground="#7F8C8D" Margin="0,3,0,0"/>
            </StackPanel>

            <Border Background="#FFF0F3" CornerRadius="12" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TxtMeetingsCount" Text="Зустрічей: 0" Foreground="#FF4B72" FontWeight="Bold" FontSize="12"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="5" BorderBrush="#EAEAEA" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbAll" Content="Всі" IsChecked="True" Style="{StaticResource FilterPillStyle}" Checked="Filter_Checked"/>
                <RadioButton x:Name="RbPending" Content="⏳ Pending" Style="{StaticResource FilterPillStyle}" Checked="Filter_Checked"/>
                <RadioButton x:Name="RbAccepted" Content="✅ Accepted" Style="{StaticResource FilterPillStyle}" Checked="Filter_Checked"/>
                <RadioButton x:Name="RbRejected" Content="❌ Rejected" Style="{StaticResource FilterPillStyle}" Checked="Filter_Checked"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="MeetingsListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="4,2,6,10"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="CardBorder"
                                            Background="White"
                                            BorderBrush="#EAEAEA"
                                            BorderThickness="1.5"
                                            CornerRadius="12"
                                            Padding="16">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0D000000"/>
                                        </Border.Effect>
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FFB3C3"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF4B72"/>
                                            <Setter TargetName="CardBorder" Property="Background" Value="#FFF9FA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" Background="#FFF0F3" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="💌" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding Initiator.FullName}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50"/>
                                    <TextBlock Text="  →  " FontSize="14" FontWeight="Bold" Foreground="#FF4B72"/>
                                    <TextBlock Text="{Binding Target.FullName}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50"/>
                                </StackPanel>

                                <TextBlock Text="{Binding MeetingDate, StringFormat='🗓️ Заплановано: {0:dd.MM.yyyy HH:mm}'}"
                                           FontSize="12" Foreground="#7F8C8D"/>
                            </StackPanel>

                            <Border Grid.Column="2" CornerRadius="8" Padding="12,5" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FEF5E7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Accepted">
                                                <Setter Property="Background" Value="#E8F8F0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                <Setter Property="Background" Value="#FDEDEC"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#D68910"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Accepted">
                                                    <Setter Property="Foreground" Value="#27AE60"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                    <Setter Property="Foreground" Value="#C0392B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="EmptyMeetingsPanel" Background="White" CornerRadius="12" Padding="30" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#10000000"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📅" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Немає запрошень на зустрічі" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                    <TextBlock Text="Сформуйте нове запрошення у розділі пошуку кандидатів або змініть фільтр." FontSize="13" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnAccept" Content="✅ Прийняти" Width="135" Height="40" Background="#2ECC71" Foreground="White" Margin="0,0,10,0" Style="{StaticResource ActionButtonStyle}" Click="BtnAccept_Click"/>
            <Button x:Name="BtnReject" Content="❌ Відхилити" Width="135" Height="40" Background="#E74C3C" Foreground="White" Margin="0,0,10,0" Style="{StaticResource ActionButtonStyle}" Click="BtnReject_Click"/>
            <Button Content="Закрити" Width="105" Height="40" Background="#EAEAEA" Foreground="#555" FontWeight="SemiBold" Style="{StaticResource ActionButtonStyle}" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>